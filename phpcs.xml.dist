<?xml version="1.0"?>
<ruleset name="TYPO3 CGL Project Ruleset">
    <!-- Beschreibung -->
    <description>TYPO3 CGL / PSR-12 conform code style checks for this project</description>

    <!-- Standard: TYPO3 and PSR-12 -->
    <rule ref="PSR12" />

    <!-- TYPO3 coding standard for extensions -->
    <rule ref="TYPO3Extension" />

   <!-- Add or modify specific rules -->
   <rule ref="Generic.Files.LineLength">
       <properties>
           <property name="lineLimit" value="120"/>
           <property name="absoluteLineLimit" value="150"/>
       </properties>
   </rule>

</ruleset>
