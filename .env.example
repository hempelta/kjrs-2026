# Mailcatcher stays locked on the live system. With ALLOWED=1 anyone with backend
# access can switch it on, and from that moment no mail leaves the site — no
# order confirmation, no form mail, no password link, and no error either.
MAILCATCHER_ALLOWED="1"
# Test API, for the Playwright suite on staging. Empty here keeps the route at 404.
MAILCATCHER_API_TOKEN=""
