PROJECT_NAME=""

# Deployment and bin-dev scripts (read locally only: .env = live, .env.staging = stage)
# Host alias from ~/.ssh/config — hostname, user and key live there, not here
REMOTE_SSH_ALIAS=""
# Deployer's deploy_path on the server
REMOTE_PROJECT_ROOT=""
# Optional: PHP binary on the server, when /usr/bin/php is older than composer.json requires
PHP_BIN=""
# Optional: user:password when the target sits behind an HTTP auth prompt (deploy:opcache needs it)
DEPLOY_HTTP_AUTH=""
# Domain without scheme (used for trustedHostPattern)
DOMAIN=""

DB_NAME=""
DB_USER=""
DB_PASS=""
DB_HOST="localhost"

ENCRYPTION_KEY=""
TYPO3_INSTALL_TOOL=""
REDIS_PASS=""

SMTP_SERVER=""
SMTP_USER=""
SMTP_PASSWORD=""
# Bool: 0 / 1
SMTP_TRANSPORT_ENCRYPT=0

DEFAULT_MAIL_FROM_ADDRESS=""
DEFAULT_MAIL_FROM_NAME=""
DEFAULT_MAIL_REPLY_TO_ADDRESS=""
DEFAULT_MAIL_REPLY_TO_NAME=""

# Mailcatcher stays locked on the live system. With ALLOWED=1 anyone with backend
# access can switch it on, and from that moment no mail leaves the site — no
# order confirmation, no form mail, no password link, and no error either.
MAILCATCHER_ALLOWED="1"
# Test API, for the Playwright suite on staging. Empty here keeps the route at 404.
MAILCATCHER_API_TOKEN=""
